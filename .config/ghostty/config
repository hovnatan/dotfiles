theme = light:GitLab Light,dark:GitLab Dark
# Start new windows in (native macOS) fullscreen; non-native would break tabs
fullscreen = true
font-size = 15
font-family = SF Mono
font-thicken = true

# Auto-install xterm-ghostty terminfo on remote hosts over ssh,
# falling back to TERM=xterm-256color where that fails.
shell-integration-features = ssh-env,ssh-terminfo

keybind = super+j=previous_tab
keybind = super+k=next_tab

# Don't ask for confirmation when closing a surface/window
confirm-close-surface = false

# Selected text goes straight to the system clipboard
copy-on-select = clipboard

mouse-hide-while-typing = true
