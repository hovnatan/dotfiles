# Environment every shell on every machine should have, in POSIX sh so bash,
# zsh (via `emulate sh`) and sh all read the same file. Sourced from:
#
#   ~/.profile      (appended by scripts/setup_user_symlinks.sh) -- login
#                   shells: bash -l, zsh -l through home/.zprofile, and so the
#                   claude-tmux service's $SHELL -lc and every Claude pane
#   .zshrc.shared   -- interactive zsh that did not start from a login shell
#
# Exports only, and idempotent: it may run twice in one process tree.

# Fallback for environments that don't set a locale (bare SSH, cron); plain C breaks UTF-8
export LANG="${LANG:-en_US.UTF-8}"

# Personal word list for hunspell (technical terms), tracked in the private
# companion repo (~/.dotfiles-private) and linked here when it is cloned
export WORDLIST="$HOME/.hunspell_en_US"

export COLORTERM=truecolor

# ripgrep reads its defaults only from this variable (home/.config/ripgrep/rc)
export RIPGREP_CONFIG_PATH="$HOME/.config/ripgrep/rc"

# Claude Code's Bash tool runs bash 5 from Nix on every machine, whatever $SHELL names:
# commands are written for bash, and zsh does not word-split `$files`. A path that stops
# existing is not an error, Claude Code silently falls back to $SHELL. Check from a tool
# call with `ps -o comm= -p $$`. A launch that reads no profile (`zsh -c claude`) gets the
# same fallback.
export CLAUDE_CODE_SHELL="$HOME/.nix-profile/bin/bash"

# Claude Code lists a session it has no name for yet in Remote Control as
# "<prefix>-<two words>", and its prefix is the host name unless this is
# set; a Mac's host name is "Mac". With the machine name
# (scripts/machine_name.sh: the per-machine file from the private repo,
# else the host name):
#
#   `claude`, a conversation resumed into it   mac-enumerated-harbor
#   the same with this set                     mbp-enumerated-harbor
#   `claude -n mbp/x`, or after a /rename      mbp/x, either way
#
# Claude Code lowercases the prefix and turns every run of other characters
# than a-z and 0-9 into one "-" (read from 2.1.328), so "mbp/" is "mbp".
# A name machine_name.sh refuses is its message at every login and no
# prefix, which leaves Claude Code at the host name: a login is not stopped
# for a session's name.
if CLAUDE_REMOTE_CONTROL_SESSION_NAME_PREFIX=$("$HOME/.dotfiles/scripts/machine_name.sh"); then
    export CLAUDE_REMOTE_CONTROL_SESSION_NAME_PREFIX
else
    unset CLAUDE_REMOTE_CONTROL_SESSION_NAME_PREFIX
fi

MAKEFLAGS="-j$(getconf _NPROCESSORS_ONLN)"
export MAKEFLAGS

case ":${PATH}:" in
    *:"$HOME/.local/bin":*)
        ;;
    *)
        # Prepending path in case a system-installed binary needs to be overridden
        export PATH="$HOME/.local/bin:$PATH"
        ;;
esac

# nvim where installed, else vim; after the PATH block so an nvim in
# ~/.local/bin counts. Matches the vim -> nvim alias in fish and zsh.
if command -v nvim >/dev/null 2>&1; then
    export EDITOR=nvim
else
    export EDITOR=vim
fi
