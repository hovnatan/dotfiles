theme = light:GitLab Light,dark:GitLab Dark
# Start new windows in (native macOS) fullscreen; non-native would break tabs
fullscreen = true
font-size = 15
font-family = SF Mono
font-thicken = true

shell-integration-features = no-ssh-env,no-ssh-terminfo

# Manual terminfo install (once per Linux/BSD host, needs `tic` there):
#
#   infocmp -x xterm-ghostty | ssh <host> -- tic -x -
#
# That writes ~/.terminfo/x/xterm-ghostty on the remote for that user
# (no root needed). tic must be ncurses >= 6.1 for the extended caps.
# Windows hosts have no tic and ignore terminfo: nothing to install.
# A host without the entry will complain about unknown terminal type;
# use TERM=xterm-256color ssh <host> there until it is installed.

keybind = super+j=previous_tab
keybind = super+k=next_tab

# Don't ask for confirmation when closing a surface/window
confirm-close-surface = false

# Selected text goes straight to the system clipboard
copy-on-select = clipboard

mouse-hide-while-typing = true
