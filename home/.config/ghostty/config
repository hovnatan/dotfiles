# Classic gruvbox, following the macOS appearance. nvim uses the matching
# gruvbox.nvim colorscheme (home/.config/nvim/lua/core/plugins.lua) and
# picks light/dark from this background at startup.
theme = light:Gruvbox Light,dark:Gruvbox Dark
# Start new windows in (native macOS) fullscreen; non-native would break tabs
fullscreen = true
font-size = 15
font-family = SF Mono
font-thicken = true

# fish reads no POSIX startup files, so run the account's login shell first
# for its environment (Nix, Homebrew, ~/.profile PATH and exports), then hand
# over to fish. On macOS Ghostty pastes this string into
# `login -flp $USER /bin/bash --noprofile --norc -c "exec -l <command>"`
# (not the `/bin/sh -c` its docs describe), so it must not start with its
# own `exec`; login(1) sets $SHELL from the passwd entry and that bash
# expands it. Detection sees "$SHELL", not fish, so name the integration
# explicitly; its XDG_DATA_DIRS hook survives the login shell into fish.
command = shell:"$SHELL" -l -c "exec fish"
shell-integration = fish
shell-integration-features = no-ssh-env,no-ssh-terminfo

# Manual terminfo install (once per Linux/BSD host, needs `tic` there):
#
#   infocmp -x xterm-ghostty | ssh <host> -- tic -x -
#
# That writes ~/.terminfo/x/xterm-ghostty on the remote for that user
# (no root needed). tic must be ncurses >= 6.1 for the extended caps.
# Windows hosts have no tic and ignore terminfo: nothing to install.
# A host without the entry will complain about unknown terminal type;
# use TERM=xterm-256color ssh <host> there until it is installed.

keybind = super+j=previous_tab
keybind = super+k=next_tab

# Ghostty follows the fixterms spec and sends ctrl+m as CSI u (ESC[109;5u)
# even in legacy mode (src/input/key_encode.zig, ctrlSeq), so programs that
# only read legacy keys -- fzf outside tmux -- type "109;5u" instead of
# accepting. Send a plain carriage return, as other terminals do; inside
# tmux this changes nothing, since tmux already decodes it to ^M.
keybind = ctrl+m=text:\r

# Don't ask for confirmation when closing a surface/window
confirm-close-surface = false

# Selected text goes straight to the system clipboard
copy-on-select = clipboard

mouse-hide-while-typing = true
