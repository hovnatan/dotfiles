# Shared git config — tracked in the dotfiles repo. Pulled in via [include] by
# ~/.gitconfig, the machine-local file git reads as global config.
# Machine-specific settings (user.email, tool injections) live in ~/.gitconfig.
[user]
  name = Hovnatan Karapetyan
[column]
  ui = auto
[branch]
  sort = -committerdate
[tag]
  sort = version:refname
[init]
  defaultBranch = main
[diff]
  algorithm = histogram
  colorMoved = plain
  mnemonicPrefix = true
  renames = true
[push]
  default = simple
  autoSetupRemote = true
  followTags = true
[fetch]
  prune = true
  pruneTags = true
  all = true
  recurseSubmodules = on-demand
[merge]
  conflictstyle = zdiff3
[core]
  editor = 'vim'
  #hooksPath = .githooks
[filter "gitignoredebugsaveimage"]
  #clean = "sed '/DebugSaveImage/{/noignore/!d}'"
	#smudge = cat
[pull]
  rebase = true
[help]
  autocorrect = prompt
[commit]
  verbose = true
[rerere]
  enabled = true
  autoupdate = true
[rebase]
  autoSquash = true
  autoStash = true
  updateRefs = true
[submodule]
  recurse = true
[credential]
  # Let gh supply the credential instead of hardcoding $GH_TOKEN. gh uses
  # GH_TOKEN when a shell exports one -- VMs that source it from a .env are
  # unaffected -- and otherwise falls back to the OAuth token in
  # ~/.config/gh/hosts.yml. The old helper had two failure modes: it handed
  # git an empty password wherever GH_TOKEN was unset, and it pinned git to
  # that token even when a broader credential existed, so a fine-grained PAT
  # that omitted a repo returned 403 on push instead of falling back.
  helper = "!gh auth git-credential"
