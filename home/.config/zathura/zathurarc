# zathura: PDF / EPUB / DjVu / PostScript / comic-book viewer, installed from
# nix/flake.nix on macOS. Recolouring is on at startup (2026-09-24).

set font 'monospace normal 14'
set adjust-open best-fit
set statusbar-home-tilde true
# No statusbar or inputbar until needed (ctrl-n toggles the statusbar)
set guioptions ''
set selection-clipboard clipboard

map d scroll half-down
map u scroll half-up
map <PageDown> scroll half-down
map <PageUp> scroll half-up
map <S-PageDown> navigate next
map <S-PageUp> navigate previous
map <C-D> toggle_page_mode
map <C-n> toggle_statusbar
# Open moves from o to O. There is no `open` shortcut function (zathura warns
# "Not a valid shortcut function: open"); the default o is this binding.
unmap o
map <S-o> focus_inputbar ":open "

# Gruvbox recolouring: page white -> the theme's background, page black ->
# its foreground, the shades in between blended. Same palette as Ghostty,
# nvim (gruvbox.nvim) and the Claude Code theme. `r` toggles it off for pages
# where colour matters (photos, plots).
set recolor true
map r recolor

# The colours: `theme` is a machine-local link to gruvbox-light or
# gruvbox-dark, whichever the system appearance is. scripts/appearance.sh
# points it, and recolours the zathura windows that are open.
include theme

# Keep the hue of coloured content while recolouring (off: all-gruvbox pages)
#set recolor-keephue true
