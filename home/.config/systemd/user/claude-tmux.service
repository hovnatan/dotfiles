[Unit]
Description=tmux session "manager" running the Claude Code manager, started at boot
Documentation=man:tmux(1)
After=default.target
# The retry below gives up after 5 failed starts in 5 minutes rather than
# trying for as long as the cause lasts.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
# Start the manager at boot and return; nothing watches it after. A manager
# that quits or crashes stays down until the next boot, a
# `systemctl --user start claude-tmux` once its session is gone (with
# another window keeping the session alive, start leaves it be), or
# `~/.dotfiles/scripts/claude_tmux_run.sh load manager --dangerous`.
# The unit goes inactive once start returns, so a later start runs it
# again (RemainAfterExit=yes would keep it "active (exited)", a start a
# no-op); `systemctl --user status claude-tmux` shows how the last run went,
# not whether the manager is up (`claude_tmux_run.sh status` does).
Type=oneshot
RemainAfterExit=no
# A start that fails (claude exiting in its startup window with no network
# yet at boot, a tmux error) is tried again 10 s later. That retries the
# start only: a start that succeeded ends the unit, and a manager quitting
# later is not one.
Restart=on-failure
RestartSec=10

# The one managed session is "manager", started in
# ~/.dotfiles/claude_tmux_session; the AGENTS.md there documents how that
# session starts and resumes the other Claude Code sessions (conversations
# named "<hostname>/<tmux name>") on this server.

# The sessions run on a dedicated socket (tmux -L claude), not the default
# one, so this service never shares a server with interactive tmux sessions.
# Attach with: tmux -L claude attach -t <name>
#
# The login shell matters: the tmux server forks from it and inherits the
# full login environment for every future pane -- claude_tmux_run.sh's
# header has the details. It is the account's own shell, whatever passwd
# says (the user manager exports it as SHELL; ExecStart's program cannot be
# a variable, hence the sh hop). tmux derives default-shell from that same
# SHELL and stamps it into every pane, so $SHELL-reading programs there see
# the passwd shell; new windows are fish regardless -- tmux.conf hardcodes
# `default-command fish`.
# A change to this file reaches a running systemd only through
# `systemctl --user daemon-reload` (scripts/update.sh runs it).
ExecStart=/bin/sh -c 'exec "$SHELL" -lc "%h/.dotfiles/scripts/claude_tmux_run.sh start"'

# No ExecStop: stopping the unit leaves every session, the manager's too,
# so a restart only starts the manager again where it is missing. The tmux
# server runs in a scope of its own (claude_tmux_run.sh, launch), so the
# unit's cgroup is empty once start returns; KillMode=process keeps a stop
# from taking the server down should it ever have been started in here.
KillMode=process

[Install]
WantedBy=default.target
