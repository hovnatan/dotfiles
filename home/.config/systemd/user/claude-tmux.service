[Unit]
Description=tmux session "claude" running the Claude Code manager
Documentation=man:tmux(1)
After=default.target
# Safety valve: if claude exits immediately (bad auth, bad config), give up
# after 10 restarts in 5 minutes instead of looping forever.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple

# The one managed session is "claude", started in
# ~/.dotfiles/claude_tmux_session; the CLAUDE.md there documents how that
# session spawns and resumes the other, unmanaged Claude Code sessions
# (conversations named "<hostname>-<tmux name>") on this server.

# The sessions run on a dedicated socket (tmux -L claude), not the default
# one, so this service never shares a server with interactive tmux sessions.
# Attach with: tmux -L claude attach -t <name>
#
# systemd still has to track the *session*, not the server: the server
# daemonizes out of ExecStart, so the watch loop in claude_tmux_run.sh is
# what keeps the unit alive, and it exits when the "claude" session
# disappears, which is what triggers Restart=always. ExecStop kills just
# that session, so the unmanaged sessions survive a service stop.
#
# The login shell matters: the tmux server forks from it and inherits the
# full login environment for every future pane -- claude_tmux_run.sh's
# header has the details. It is the account's own shell, whatever passwd
# says (the user manager exports it as SHELL; ExecStart's program cannot be
# a variable, hence the sh hop). tmux derives default-shell from that same
# SHELL and stamps it into every pane, so $SHELL-reading programs there see
# the passwd shell; new windows are zsh regardless -- tmux.conf hardcodes
# `default-command zsh`.
ExecStart=/bin/sh -c 'exec "$SHELL" -lc "%h/.dotfiles/scripts/claude_tmux_run.sh"'
# ExecStop runs on EVERY deactivation, including the self-exit restart
# cycles the watcher relies on (systemd.service: "the stop operation is
# always performed ... even if the processes in the service terminated on
# their own"). Killing the session is only wanted on a real stop request,
# so guard on ${MAINPID}: it is unset when the watcher already exited by
# itself (restart cycle), set when a live service is being stopped.
ExecStop=/bin/sh -c 'test -z "${MAINPID}" || exec %h/.dotfiles/scripts/claude_tmux_run.sh stop'

# Kill only the watcher when the unit deactivates: the tmux server
# daemonizes into this cgroup, and the default control-group kill would
# take down every session -- including the unmanaged ones -- on each
# watcher-exit/restart cycle. ExecStop above already kills precisely the
# managed session.
KillMode=process

Restart=always
RestartSec=5

[Install]
WantedBy=default.target
