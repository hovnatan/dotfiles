<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- D-Bus session bus at ~/.cache/bus, for zathura to take commands on
     (scripts/macos/dbus_session.sh says why there). Started at login and
     again after a crash; an exit with an error (dbus not installed yet) is
     logged and left at that. Through sh, as launchd expands no $HOME.
     Symlinked into ~/Library/LaunchAgents by scripts/setup_user_symlinks.sh. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.hovnatan.dbus-session</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>exec "$HOME/.dotfiles/scripts/macos/dbus_session.sh"</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>Crashed</key>
    <true/>
  </dict>
</dict>
</plist>
