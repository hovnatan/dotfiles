Include local_config*

Host *
  ControlMaster auto
  ControlPath /tmp/ssh-%C
  ControlPersist 10m
  ServerAliveInterval 15
  ServerAliveCountMax 3
  # Bounds the TCP connect and the server's greeting (banner exchange),
  # which ServerAlive* does not cover: it starts only once logged in.
  # Without it, a server that accepts the connection and never answers
  # hangs ssh for good, as a dying tailscaled did with Tailscale SSH
  # (2026-10-30: ssh tabs restored mid-restart stayed blank for hours):
  #   no ConnectTimeout   -> waits forever
  #   ConnectTimeout 10   -> "Connection timed out during banner exchange"
  # Through ProxyJump/ProxyCommand the greeting waits on the jump host's
  # own login too, so one that asks for a password or 2FA needs a longer
  # one: `Host <behind-jump>` / `ConnectTimeout 120` in local_config, read
  # first above, wins.
  ConnectTimeout 10
