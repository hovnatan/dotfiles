# shellcheck settings for this repo.  `scripts/check.sh shell` (CI's
# .github/workflows/shellcheck.yml and the pre-push hook) lints every tracked
# .sh and scripts/git-hooks/* at warning level; info/style notes are advisory.
# Every tracked .sh is bash or sh; shellcheck cannot lint zsh, so a zsh script
# would need a different extension or a documented exclusion here.
external-sources=true
